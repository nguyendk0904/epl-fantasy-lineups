# Git Ignore Rules for Fantasy Lineup Monorepo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Node / React
node_modules/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
*.local

# Environment Variables
.env
.env.local
.env.production.local
.env.development.local

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker
*.docker.log

# Terraform local state & credentials
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Variable files can hold db_password -> never commit them (examples only)
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
