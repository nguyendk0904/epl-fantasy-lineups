# Root Environment Configuration Example
# Copy this file to .env for local development

# Environment
ENVIRONMENT=development
PORT=8000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fantasy_fpl
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fantasy_fpl

# FPL API
FPL_BOOTSTRAP_URL=https://fantasy.premierleague.com/api/bootstrap-static/

# Frontend URL
VITE_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# AWS Production Deployment (Phase 2 & 3)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_ID=

# FPL sync worker (P2-NH03) - exactly ONE worker process, never two
FPL_SYNC_ENABLED=false
FPL_SYNC_INTERVAL_SECONDS=21600

# CloudWatch logging (P3-NH01) - no keys: credentials come from the instance role
LOG_LEVEL=INFO
CLOUDWATCH_LOGGING_ENABLED=false
CLOUDWATCH_LOG_GROUP=/fpl/backend
CLOUDWATCH_SEND_INTERVAL_SECONDS=5

# Rate limiting (P3-NH02)
# memory:// is correct for ONE process only (current deployment: 1 uvicorn
# worker in 1 container). Set a shared redis:// URL before adding workers or
# replicas, otherwise every process counts separately.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
# RATE_LIMIT_STORAGE_URI=redis://fpl-redis.example:6379/0

# Backend TLS + trusted proxy are configured on the container command line
# (uvicorn --proxy-headers --forwarded-allow-ips=<docker bridge gateway>),
# never as a plaintext secret in this file.

