# =====================================================================
# P1-Q01 - Docker build-context ignore rules (monorepo root)
# Keeps images lean & prevents leaking secrets/caches into containers
# =====================================================================

# --- Git ---
.git
.gitignore
.github

# --- Python ---
__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.coverage
htmlcov
backend/venv
backend/.venv
venv
.venv

# --- Node / React ---
node_modules
frontend/dist
frontend/dist-ssr
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment & secrets (never bake secrets into images) ---
.env
.env.*
*.local

# --- IDE / OS ---
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docs / infra / scripts (not required inside containers) ---
*.md
infra
scripts